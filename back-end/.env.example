# Servidor do Painel de Saídas
PORT=3000
FRONTEND_URL=https://seu-frontend.exemplo
PROVIDER_TIMEOUT_MS=25000

# FlightRadar / SIGA-Malha (fonte principal de voos)
# O backend acrescenta /siga-flights/public à URL base.
MALHA_BASE_URL=https://sua-api-malha.exemplo
SIGA_STREAM_API_KEY=SUA_CHAVE_AQUI
# Timeout exclusivo do snapshot volumoso da Malha.
SIGA_TIMEOUT_MS=120000

# Fonia — escalados da Fonia, rota de SAÍDAS (header x-api-key, ?data=YYYY-MM-DD).
# Casamento com a Malha por data + voo de saída. Vazio = linha FONIA cinza.
FONIA_API_URL=https://sua-api-fonia.exemplo/integracao/saidas/escalados
FONIA_API_KEY=

# QTU / QTA — deixe vazio até a API estar validada; as linhas ficam cinza.
# GET {REST_API_BASE_URL}/voos?tipo=saida&data=YYYY-MM-DD  (Bearer opcional)
REST_API_BASE_URL=
REST_API_TOKEN=

# Pushback — escalados da ferramenta de pushback (header x-api-key, ?data=YYYY-MM-DD).
# Casamento com a Malha por data + voo de saída. Vazio = linha PUSHBACK cinza.
PUSH_API_BASE_URL=https://sua-api-pushback.exemplo/integracao/escalados
PUSH_API_TOKEN=
