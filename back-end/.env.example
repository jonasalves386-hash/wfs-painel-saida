# Servidor do Painel de Saídas
PORT=3000
FRONTEND_URL=https://seu-frontend.exemplo
PROVIDER_TIMEOUT_MS=25000

# FlightRadar / SIGA-Malha (fonte principal de voos)
# O backend acrescenta /siga-flights/public à URL base.
MALHA_BASE_URL=https://sua-api-malha.exemplo
SIGA_STREAM_API_KEY=SUA_CHAVE_AQUI
# Timeout exclusivo do snapshot volumoso da Malha.
SIGA_TIMEOUT_MS=120000

# Fonia (wfs-fonia) — deixe vazio até a API estar validada; a linha FONIA fica cinza.
# GET {FONIA_API_BASE_URL}/fonia/public?data=YYYY-MM-DD  (header x-api-key)
FONIA_API_BASE_URL=
FONIA_STREAM_API_KEY=

# Pushback / QTU / QTA — deixe vazio até a API estar validada; as linhas ficam cinza.
# GET {REST_API_BASE_URL}/voos?tipo=saida&data=YYYY-MM-DD  (Bearer opcional)
REST_API_BASE_URL=
REST_API_TOKEN=
# Serviços desta API que podem sinalizar (os demais ficam cinza). Ex.: pushback,qtu,qta
REST_SERVICOS=pushback
